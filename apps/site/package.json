{
  "name": "@swipe/site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:cf": "wrangler dev",
    "build": "node scripts/write-deploy-marker.mjs && pnpm build:sitemap && node scripts/check-issue-parity.mjs && astro build && node scripts/check-agent-artifacts.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "check": "astro check && node ../../packages/swipe/test/issue-qa-routing.test.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@iannuttall/seo-graph-astro": "^0.0.3",
    "@paper-design/shaders": "^0.0.78",
    "@tailwindcss/vite": "^4.3.3",
    "alpinejs": "^3.15.12",
    "astro": "^7.1.3",
    "canvas-confetti": "^1.9.4",
    "js-yaml": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.114.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/alpinejs": "^3.13.11",
    "@types/canvas-confetti": "^1.9.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  }
}
