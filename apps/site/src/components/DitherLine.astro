---
/**
 * Short dither separator: a solid rule that breaks apart into sparse dots.
 * Ported as-is from the same component in the `readme` project.
 *
 * Takes `currentColor`, so set the colour with a text utility on the caller.
 * Renders at its natural 60x2 (or 4x60) size.
 */
interface Props {
  orientation?: "horizontal" | "vertical";
  class?: string;
}

const { orientation = "horizontal", class: className }: Props = Astro.props;

const DITHER_PATH =
  "M1  0H41V1H40V0ZM43 0H42V1H43V0ZM45 0H46V1H45V0ZM45 1V2H44V1H45ZM49 0H48V1H49V2H50V1H49V0ZM51 0H52V1H51V0ZM55 0H54V1H55V2H56V1H55V0ZM59 0H60V1H59V0Z";
---

{
  orientation === "vertical" ? (
    <svg
      class={className}
      width="4"
      height="60"
      viewBox="0 0 2 60"
      fill="none"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
    >
      <g transform="rotate(90 1 1) translate(0 -1)">
        <path fill-rule="evenodd" clip-rule="evenodd" d={DITHER_PATH} fill="currentColor" />
      </g>
    </svg>
  ) : (
    <svg
      class={className}
      width="60"
      height="2"
      viewBox="0 0 60 2"
      fill="none"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path fill-rule="evenodd" clip-rule="evenodd" d={DITHER_PATH} fill="currentColor" />
    </svg>
  )
}
