---
export const prerender = true;

import ToolDirectoryPage from "@/components/tools/ToolDirectoryPage.astro";
import {
  getVisibleTools,
  paginateTools,
  toolPageCount,
} from "@/lib/tools";

export async function getStaticPaths() {
  const tools = await getVisibleTools();
  const totalPages = toolPageCount(tools.length);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: {
        tools: paginateTools(tools, page),
        currentPage: page,
        totalPages,
      },
    };
  });
}

type Props = {
  tools: Awaited<ReturnType<typeof getVisibleTools>>;
  currentPage: number;
  totalPages: number;
};

const { tools, currentPage, totalPages } = Astro.props as Props;
---

<ToolDirectoryPage
  tools={tools}
  currentPage={currentPage}
  totalPages={totalPages}
  canonicalPath={`/tools/page/${currentPage}`}
/>
