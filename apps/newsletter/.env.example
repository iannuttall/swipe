# Local and VPS runtime
COMPOSE_PROJECT_NAME=swipe
APP_NAME=swipe
EMAIL_APP_NAME=Swipe
MAIN_SITE_NAME=Swipe
MAIN_SITE_URL=https://swipe.md
APP_DOMAIN=origin.swipe.md
APP_HOSTS=origin.swipe.md
APP_HOSTS_LIST=origin.swipe.md
APP_PORT=3000
WEB_PORT=3002
APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=3011
WEB_HOST_PORT=3012
APP_IMAGE=swipe:local

# Local development Postgres port
POSTGRES_PORT=55433

# Production Postgres container settings
POSTGRES_DB=swipe
POSTGRES_USER=swipe
POSTGRES_PASSWORD=change-me

# Required in deployed environments
DATABASE_URL=postgresql://swipe:swipe@localhost:55433/swipe
BASE_URL=https://swipe.md
EMAIL_API_INTERNAL_URL=http://app:3000
API_TOKEN=change-me
UNSUBSCRIBE_SECRET=change-me
TRACKING_SECRET=change-me
CONFIRMATION_SECRET=change-me
SWIPE_INVITE_SECRET=change-me
SWIPE_INVITE_BASE_URL=https://swipe.md
EMAIL_CONFIRMATION_BASE_URL=https://swipe.md
EMAIL_CONFIRMATION_TTL_HOURS=72
EMAIL_DOUBLE_OPT_IN=true
EMAIL_PROVIDER=ses
EMAIL_FROM_EMAIL=hello@swipe.md
EMAIL_FROM_NAME=Ian at Swipe
EMAIL_TRACK_OPENS=false
EMAIL_SEND_RATE_PER_SECOND=14

# Required only when using the SES provider
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_WEBHOOK_SECRET=change-me
AWS_SNS_ALLOWED_TOPICS=
