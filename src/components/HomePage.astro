---
import { BackgroundCards } from '@/components/BackgroundCards'
import { HomeHero } from '@/components/HomeHero'
import type { CardVersion } from '@/data/home-cards'

type Props = {
  backgroundSeed: number
  cardVersion?: CardVersion
}

const { backgroundSeed, cardVersion } = Astro.props
---

<main class="relative h-dvh overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 z-10"
    style={{
      background: `
        linear-gradient(to right, var(--bg) 0%, transparent 6%, transparent 94%, var(--bg) 100%),
        linear-gradient(to bottom, var(--bg) 0%, transparent 4%, transparent 96%, var(--bg) 100%)
      `,
    }}
  >
  </div>

  <HomeHero client:idle />
  <BackgroundCards seed={backgroundSeed} version={cardVersion} />
</main>
