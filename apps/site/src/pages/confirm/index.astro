---
import Layout from "@/layouts/Layout.astro";

export const prerender = true;
---

<Layout
  title="Confirm your Swipe subscription"
  description="Confirm that you want to receive Swipe."
  canonicalPath="/confirm"
  noIndex
>
  <meta slot="head" name="referrer" content="no-referrer" />
  <script
    slot="head"
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    async
    defer
  ></script>

  <section class="mx-auto max-w-xl py-16 text-center">
    <h1 class="text-4xl font-semibold tracking-tight">Confirm your subscription</h1>
    <div class="mt-6" x-data="subscriptionConfirmation">
      <p x-text="message">Checking this confirmation link...</p>
      <div x-ref="turnstile" class="mt-6 flex justify-center"></div>
      <p x-show="status === 'success'" class="mt-6">
        <a href="/" class="underline">Go to Swipe</a>
      </p>
    </div>
  </section>
</Layout>
