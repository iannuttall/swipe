---
import SiteWordmark from "@/components/content/SiteWordmark.astro";

// `/about` is unpublished for now, so it stays out of the nav.
const links = [{ href: "/issues", label: "Issues" }];

const current = Astro.url.pathname.replace(/\/$/, "");
---

<header class="pt-7 pb-2 sm:pt-9">
  <div class="site-column flex items-center justify-between gap-6">
    <SiteWordmark />
    <nav aria-label="Main navigation" class="flex items-center gap-5 text-sm">
      {
        links.map((link) => {
          const active = current === link.href || current.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "no-underline transition-colors",
                active ? "text-foreground" : "text-muted hover:text-foreground",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
