---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<header class="max-w-2xl">
  <h1 class="font-heading text-4xl leading-tight font-semibold tracking-tight sm:text-5xl">
    {title}
  </h1>
  {description ? <p class="mt-4 text-lg leading-7 text-muted">{description}</p> : null}
</header>
