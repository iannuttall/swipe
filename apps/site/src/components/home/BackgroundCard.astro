---
import type { CardDef } from "@/data/home-cards";

interface Props {
  card: CardDef;
}

const { card } = Astro.props;

function lines(text: string) {
  return text.split("\n");
}
---

{
  card.type === "terminal" ? (
    <div class="flex flex-col overflow-hidden rounded-xl border border-foreground/9 bg-foreground/3">
      <div class="flex items-center gap-1.5 border-b border-foreground/7 px-3.5 py-2">
        <span class="h-2 w-2 rounded-full bg-foreground/10"></span>
        <span class="h-2 w-2 rounded-full bg-foreground/10"></span>
        <span class="h-2 w-2 rounded-full bg-foreground/10"></span>
        <span class="ml-2 font-mono text-2xs uppercase tracking-widest text-foreground/25">
          {card.title}
        </span>
      </div>
      <div class="px-3.5 py-3 font-mono text-xs leading-relaxed text-foreground/32">
        {lines(card.text).map((line, index, all) => (
          <Fragment>
            {line}
            {index < all.length - 1 ? <br /> : null}
          </Fragment>
        ))}
      </div>
    </div>
  ) : card.type === "file" ? (
    <div class="overflow-hidden rounded-xl border border-foreground/9 bg-background/40">
      <div class="flex items-stretch border-b border-foreground/7 bg-foreground/3">
        <div class="border-r border-foreground/7 px-3.5 py-1.5 font-mono text-2xs text-foreground/32">
          {card.filename}
        </div>
      </div>
      <div class="px-3.5 py-3 font-mono text-xs leading-relaxed text-foreground/30">
        {lines(card.text).map((line, index, all) => (
          <Fragment>
            {line}
            {index < all.length - 1 ? <br /> : null}
          </Fragment>
        ))}
      </div>
    </div>
  ) : card.type === "plan" ? (
    <div class="overflow-hidden rounded-xl border border-foreground/9 bg-background/40 px-3.5 py-3">
      <div class="mb-2 font-mono text-2xs uppercase tracking-widest text-foreground/20">
        plan mode
      </div>
      <div class="mb-2 font-mono text-xs leading-relaxed font-medium text-foreground/42">
        {card.question}
      </div>
      <div class="flex flex-col gap-1">
        {card.options.map((option, index) => {
          const selected = index === (card.selected ?? 0);
          return (
            <div class="font-mono text-2xs leading-relaxed">
              <div class={selected ? "text-foreground/42" : "text-foreground/26"}>
                <span class="inline-block w-4 text-foreground/18">{selected ? "›" : " "}</span>
                {index + 1}. {option.label}
              </div>
              <div class="ml-4 pl-2 text-2xs text-foreground/18">{option.desc}</div>
            </div>
          );
        })}
      </div>
    </div>
  ) : card.type === "chat" ? (
    <div class="flex flex-col gap-2.5">
      {card.messages.map((message) => {
        const user = message.role === "user";
        return (
          <div class:list={["flex", user ? "justify-end" : "justify-start"]}>
            <div
              class:list={[
                "max-w-11/12 rounded-xl px-3.5 py-2.5 text-xs leading-normal",
                user
                  ? "bg-foreground/8 text-foreground/45"
                  : "border border-foreground/9 bg-background/35 text-foreground/36",
              ]}
            >
              {lines(message.text).map((line, index, all) => (
                <Fragment>
                  {line}
                  {index < all.length - 1 ? <br /> : null}
                </Fragment>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  ) : card.type === "message" ? (
    <div class="overflow-hidden rounded-xl border border-foreground/9 bg-background/35 px-3.5 py-3">
      <div class="mb-2 flex items-baseline justify-between gap-3">
        <span class="text-xs font-semibold text-foreground/45">{card.sender}</span>
        <span class="font-mono text-2xs text-foreground/22">{card.time ?? "now"}</span>
      </div>
      <div class="text-xs leading-normal text-foreground/34">
        {lines(card.text).map((line, index, all) => (
          <Fragment>
            {line}
            {index < all.length - 1 ? <br /> : null}
          </Fragment>
        ))}
      </div>
    </div>
  ) : null
}
