---
import type { CollectionEntry } from "astro:content";
import { toolInitials } from "@/lib/tools";

interface Props {
  tool: CollectionEntry<"tools">;
}

const { tool } = Astro.props;
---

<a
  href={`/tools/${tool.id}`}
  class="quiet-card tool-card flex h-full flex-col p-5 no-underline"
>
  <div class="flex items-start justify-between gap-4">
    <span
      class="grid size-11 shrink-0 place-items-center overflow-hidden bg-background font-mono text-sm font-semibold text-[#0f1115]"
      aria-hidden="true"
    >
      {
        tool.data.icon ? (
          <img
            src={tool.data.icon}
            alt=""
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
            class="size-full object-contain"
          />
        ) : (
          toolInitials(tool.data.name)
        )
      }
    </span>
    <span class="pt-1 text-right font-mono text-[0.68rem] leading-snug text-muted">
      {tool.data.category}
    </span>
  </div>

  <div class="mt-6">
    <h2 class="tool-card-title font-heading text-lg leading-tight font-semibold tracking-tight text-pretty">
      {tool.data.name}
    </h2>
    <p class="tool-card-tagline mt-2 text-sm leading-snug text-muted text-pretty">
      {tool.data.tagline}
    </p>
  </div>
</a>
