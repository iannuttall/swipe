---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & {
  variant?: "default" | "primary";
  size?: "default" | "hero";
  "x-bind:disabled"?: string;
};

const {
  variant = "default",
  size = "default",
  class: className,
  ...props
} = Astro.props as Props;

const variants = {
  default: "bg-button text-button-fg hover:opacity-90",
  primary: "bg-button text-button-fg hover:opacity-90",
};

// Type treatment lives here rather than in the base so callers can pick a size
// without fighting a base class. `class:list` concatenates, it does not merge,
// so two competing text-transform utilities would be resolved by stylesheet
// order instead of by intent.
const sizes = {
  default: "h-10 px-4 text-sm font-medium",
  hero: "h-12 px-6 font-heading text-base font-semibold",
};
---

<button
  class:list={[
    "shrink-0 cursor-pointer rounded-none whitespace-nowrap transition-opacity disabled:cursor-not-allowed disabled:opacity-60",
    variants[variant],
    sizes[size],
    className,
  ]}
  {...props}
>
  <slot />
</button>
