---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

/**
 * Pixelarticons wrapper, matching the pattern used in the `seo` project.
 *
 * Icons live in `./pixelarticons`. Only the ones this site uses are vendored —
 * copy more across from `~/dev/cli/seo/apps/web/src/components/icons/pixelarticons`
 * as they are needed and they resolve here automatically.
 */
type Props = {
  name: string;
  class?: string;
  /** Give a title only when the icon is the sole label for a control. */
  title?: string;
  [key: string]: unknown;
};

const { name, class: className, title, ...props } = Astro.props as Props;
const icons = import.meta.glob<{ default: AstroComponentFactory }>("./pixelarticons/*.astro", {
  eager: true,
});
const Icon = icons[`./pixelarticons/${name}.astro`]?.default;
---

{
  Icon && (
    <Icon
      class={className}
      aria-hidden={title ? undefined : "true"}
      aria-label={title}
      role={title ? "img" : undefined}
      {...props}
    />
  )
}
