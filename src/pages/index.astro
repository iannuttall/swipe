---
export const prerender = false

import HomePage from '@/components/HomePage.astro'
import Layout from '@/layouts/Layout.astro'
import { toCardVersion } from '@/data/home-cards'

const backgroundSeed = crypto.getRandomValues(new Uint32Array(1))[0]
// Switch background card sets with ?cards=v1 | v2 | v3 | v4 while testing.
const cardVersion = toCardVersion(Astro.url.searchParams.get('cards'))

Astro.response.headers.set('Cache-Control', 'no-store')
---

<Layout title="SWIPE.md | Do cool things with AI" canonicalPath="/">
  <HomePage backgroundSeed={backgroundSeed} cardVersion={cardVersion} />
</Layout>
