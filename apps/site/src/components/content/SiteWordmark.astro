---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="/"
  class:list={[
    "block w-11 no-underline",
    className,
  ]}
  aria-label="Swipe home"
>
  <span
    x-data="swipeLogo"
    class="block aspect-[675.611/501.047] w-full [&_svg]:block [&_svg]:h-auto [&_svg]:w-full"
    aria-hidden="true"
  ></span>
</a>
