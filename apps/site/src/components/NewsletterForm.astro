---
import Button from "@/components/ui/button.astro";
import Input from "@/components/ui/input.astro";

interface Props {
  source: string;
  buttonText?: string;
  compact?: boolean;
}

const {
  source,
  buttonText = "Subscribe",
  compact = false,
} = Astro.props;
const inputId = `newsletter-${source.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`;
---

<div
  x-data={`newsletterSignup(${JSON.stringify({ source })})`}
  class="[--primary:#ff4fa3]"
>
  <div
    x-cloak
    x-show="status === 'success'"
    class="flex items-center gap-4 border-l-4 border-[#ff4fa3] bg-white/6 px-4 py-3 sm:px-5 sm:py-4"
    role="status"
    aria-live="polite"
  >
    <span
      class="grid size-10 shrink-0 place-items-center bg-[linear-gradient(135deg,#ff4fa3_0%,#d92fd0_100%)] text-xl font-bold text-white"
      aria-hidden="true"
    >
      ✓
    </span>
    <div>
      <p class="text-lg font-bold text-white sm:text-xl">You're in.</p>
      <p class="mt-0.5 text-sm text-white/70 sm:text-base">
        Check your inbox to confirm.
      </p>
    </div>
  </div>

  <form
    x-show="status !== 'success'"
    x-on:submit.prevent="submit"
    class="space-y-2"
  >
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end">
      <label for={inputId} class="sr-only">Email address</label>
      <Input
        id={inputId}
        name="email"
        type="email"
        size={compact ? "default" : "hero"}
        x-model="email"
        x-bind:aria-invalid="status === 'error' ? 'true' : 'false'"
        placeholder="sam@openai.com"
        autocomplete="email"
        required
      />
      <Button
        type="submit"
        variant="primary"
        size={compact ? "default" : "hero"}
        x-bind:disabled="status === 'loading'"
        class:list={[!compact && "subscribe-button text-white"]}
      >
        <span x-text={`status === 'loading' ? 'Sending...' : ${JSON.stringify(buttonText)}`}>
          {buttonText}
        </span>
      </Button>
    </div>
    <p
      x-cloak
      x-show="status === 'error'"
      x-text="message"
      class="text-sm"
      role="alert"
    >
    </p>
  </form>
</div>
