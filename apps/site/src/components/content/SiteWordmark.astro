---
interface Props {
  class?: string;
  variant?: "nav" | "hero";
}

const { class: className, variant = "nav" } = Astro.props;
---

<a
  href="/"
  class:list={[
    "block no-underline",
    variant === "hero" ? "w-14 sm:w-16" : "w-11",
    className,
  ]}
  aria-label="Swipe home"
>
  <span
    x-data="swipeLogo"
    class="block aspect-[675.611/501.047] w-full [&_svg]:block [&_svg]:h-auto [&_svg]:w-full"
    aria-hidden="true"
  ></span>
</a>
