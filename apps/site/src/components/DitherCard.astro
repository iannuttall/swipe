---
import Dither from "@/components/Dither.astro";

interface Props {
  class?: string;
  stripSize?: number;
  /** Distinguishes the two strips of one card from those of another. */
  seed?: string;
}

const { class: className, stripSize = 16, seed = "card" } = Astro.props;
---

<div class:list={["flex flex-col", className]}>
  <Dither height={stripSize} back="--bg" front="--fg" seed={`${seed}-top`} />
  <div
    class="flex-1 px-7 py-7 sm:px-8 sm:py-8"
    style={{
      backgroundColor: "var(--card-inv-bg)",
      color: "var(--card-inv-fg)",
      "--bg": "var(--card-inv-bg)",
      "--fg": "var(--card-inv-fg)",
      "--primary": "var(--primary-inv)",
      "--primary-fg": "var(--primary-inv-fg)",
      "--border": "color-mix(in oklch, var(--card-inv-fg) 25%, transparent)",
      "--muted": "color-mix(in oklch, var(--card-inv-fg) 60%, transparent)",
    }}
  >
    <slot />
  </div>
  <Dither height={stripSize} back="--bg" front="--fg" seed={`${seed}-bottom`} reverse />
</div>
