---
export const prerender = true;

import type { CollectionEntry } from "astro:content";
import CodeCopy from "@/components/content/CodeCopy.astro";
import PageHeader from "@/components/content/PageHeader.astro";
import IssueSections from "@/components/issues/IssueSections.astro";
import Layout from "@/layouts/Layout.astro";
import { formatIssueDate, getVisibleIssues, issueReadingMinutes } from "@/lib/issues";
import { parseIssueSections } from "@/lib/issues/parser";

export async function getStaticPaths() {
  const issues = await getVisibleIssues();
  return issues.map((issue) => ({
    params: { slug: issue.id },
    props: { issue },
  }));
}

type Props = { issue: CollectionEntry<"issues"> };
const { issue } = Astro.props as Props;
const path = `/issues/${issue.id}`;
const readingMinutes = issueReadingMinutes(issue.body ?? "");
const title = issue.data.title ?? issue.data.subject;
const issueLabel = parseIssueSections(issue.body ?? "").find(
  (section) => section.type === "header",
)?.attrs.name;
const description =
  issue.data.description ?? issue.data.preheader ?? title;
const meta = [
  issueLabel,
  formatIssueDate(issue.data.pubDate),
  `${readingMinutes} min read`,
]
  .filter(Boolean)
  .join(" · ");
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: issue.data.pubDate.toISOString(),
  dateModified: (issue.data.sentAt ?? issue.data.pubDate).toISOString(),
  mainEntityOfPage: new URL(path, Astro.site).toString(),
  publisher: {
    "@type": "Organization",
    name: "Swipe",
    url: new URL("/", Astro.site).toString(),
  },
};
const issueFontStyle = {
  "--font-body": "'Inter', 'Inter Fallback', Helvetica, Arial, sans-serif",
  "--font-heading": "'Inter', 'Inter Fallback', Helvetica, Arial, sans-serif",
  fontFamily: "'Inter', 'Inter Fallback', Helvetica, Arial, sans-serif",
};
---

<Layout
  title={title}
  description={description}
  canonicalPath={path}
  ogType="article"
  structuredData={schema}
  preloadInter
>
  <article
    class="mx-auto w-full max-w-[40rem]"
    style={issueFontStyle}
  >
    <PageHeader
      title={title}
      description={issue.data.description ?? issue.data.preheader}
      eyebrow={meta}
    />
    {
      issue.data.draft ? (
        <p class="mt-4 font-mono text-sm text-primary">Draft preview</p>
      ) : null
    }

    <div class="mt-10">
      <IssueSections body={issue.body ?? ""} markdownPath={`${path}.md`} />
    </div>
    <CodeCopy />
  </article>
</Layout>
