---
export const prerender = true;
Astro.response.status = 404;

import PageHeader from "@/components/content/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Page not found"
  description="That Swipe page does not exist."
  canonicalPath="/404"
  noIndex
>
  <PageHeader
    title="Page not found"
    description="That link goes nowhere."
  />
  <p class="mt-8 text-lg">
    Try the <a class="underline underline-offset-2" href="/issues">issue archive</a>.
  </p>
</Layout>
