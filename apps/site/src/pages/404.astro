---
export const prerender = true;
Astro.response.status = 404;

import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Page not found"
  description="That Swipe page does not exist."
  canonicalPath="/404"
  noIndex
>
  <div class="max-w-xl">
    <h1 class="font-heading text-4xl font-semibold">Page not found</h1>
    <p class="mt-4 text-lg text-muted">
      That link goes nowhere. Try the <a class="underline underline-offset-2" href="/issues">issue archive</a>.
    </p>
  </div>
</Layout>
