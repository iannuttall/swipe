---
export const prerender = true;

import NewsletterSignup from "@/components/content/NewsletterSignup.astro";
import PageHeader from "@/components/content/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { formatIssueDate, getVisibleIssues } from "@/lib/issues";

const issues = await getVisibleIssues();
const description =
  "Every Swipe issue, with practical AI skills, prompts, tools, and workflows you can steal.";
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Swipe issues",
  description,
  url: new URL("/issues", Astro.site).toString(),
};
---

<Layout
  title="Issues"
  description={description}
  canonicalPath="/issues"
  structuredData={schema}
>
  <PageHeader title="Issues" description={description} />

  <div class="mt-10">
    <NewsletterSignup source="swipe.md/issues" />
  </div>

  {
    issues.length === 0 ? (
      <p class="mt-12 text-muted">No published issues yet.</p>
    ) : (
      <ol class="mt-12 space-y-3">
        {issues.map((issue) => (
          <li>
            <a
              href={`/issues/${issue.id}`}
              class="quiet-card block px-5 py-6 no-underline sm:px-6"
            >
              <time
                class="font-mono text-xs text-muted"
                datetime={issue.data.pubDate.toISOString()}
              >
                {formatIssueDate(issue.data.pubDate)}
              </time>
              <p class="mt-2 font-heading text-xl leading-snug font-semibold tracking-tight text-pretty">
                {issue.data.title ?? issue.data.subject}
              </p>
              {issue.data.description ?? issue.data.preheader ? (
                <p class="mt-1.5 text-base leading-normal text-muted text-pretty">
                  {issue.data.description ?? issue.data.preheader}
                </p>
              ) : null}
            </a>
          </li>
        ))}
      </ol>
    )
  }
</Layout>
