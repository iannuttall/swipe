---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & {
  variant?: "default" | "primary";
  size?: "default" | "hero";
  "x-bind:disabled"?: string;
};

const {
  variant = "default",
  size = "default",
  class: className,
  ...props
} = Astro.props as Props;

const variants = {
  default: "bg-foreground text-background",
  primary: "bg-primary text-primary-fg hover:bg-primary/90",
};

const sizes = {
  default: "h-10 px-4 py-1.5",
  hero: "h-12 px-6",
};
---

<button
  class:list={[
    "shrink-0 cursor-pointer whitespace-nowrap rounded-none text-xs uppercase tracking-widest disabled:cursor-not-allowed disabled:opacity-60",
    variants[variant],
    sizes[size],
    className,
  ]}
  {...props}
>
  <slot />
</button>
